# Port the worker listens on (internal only — do not expose publicly).
PORT=8088
# Shared secret Courant presents to /send and the worker presents to the webhook.
WA_WORKER_TOKEN=change-me-long-random
# Where to POST inbound WhatsApp messages (Courant). Leave empty to just log them.
COURANT_WEBHOOK_URL=
# Folder where the WhatsApp session is persisted (so you scan the QR only once).
SESSION_DIR=./.wwebjs_auth
# Human-like pacing between sends, milliseconds (min..max). Lowers ban risk.
SEND_MIN_MS=8000
SEND_MAX_MS=25000
