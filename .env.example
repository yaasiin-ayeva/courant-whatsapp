# Port the worker listens on (put nginx+TLS in front; keep the app bound to localhost).
PORT=8088

# API keys clients present to call this worker, as X-API-Key or "Authorization: Bearer".
# Comma-separated; create one per integration so you can revoke it on its own.
# Format convention: wa_<64 hex>. Generate: openssl rand -hex 32 | sed 's/^/wa_/'
WA_API_KEYS=wa_change_me

# Shared token the worker signs inbound webhooks with (X-Token), verified by Courant.
WA_WEBHOOK_TOKEN=change-me-long-random
# Where to POST inbound WhatsApp messages (Courant). Empty = just log them.
COURANT_WEBHOOK_URL=

# WhatsApp session persistence (scan the QR only once).
SESSION_DIR=./.wwebjs_auth
# Human-like pacing between sends, milliseconds (min..max). Lowers ban risk.
SEND_MIN_MS=8000
SEND_MAX_MS=25000
