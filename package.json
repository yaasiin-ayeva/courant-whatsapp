{
  "name": "courant-whatsapp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone WhatsApp transport for Courant, driven by whatsapp-web.js. Pairs a real number (QR), sends outbound messages with human-like pacing and a durable queue, and forwards inbound messages to Courant over a signed webhook. No vendor/BSP, no per-message cost.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
