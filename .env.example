# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8088
LOG_LEVEL=info

# API keys clients present as X-API-Key or "Authorization: Bearer".
# Comma-separated; one per integration so you can revoke it on its own.
# Generate: openssl rand -hex 32 | sed 's/^/wa_/'  — REQUIRED in production.
WA_API_KEYS=wa_change_me

# ── Webhook to Courant (inbound messages + delivery status) ───────────────────
# Empty = log only. Body is signed HMAC-SHA256 (X-Signature) + X-Token raw secret.
COURANT_WEBHOOK_URL=
WA_WEBHOOK_TOKEN=change-me-long-random

# ── WhatsApp session ──────────────────────────────────────────────────────────
WA_CLIENT_ID=courant
SESSION_DIR=/app/.wwebjs_auth
DATA_DIR=/app/data
# Check the recipient is on WhatsApp before sending (getNumberId).
WA_VALIDATE_NUMBERS=true

# ── Human-like pacing / anti-ban ──────────────────────────────────────────────
# Random delay between two sends.
SEND_MIN_MS=8000
SEND_MAX_MS=25000
# "typing…" shown before a send (length-scaled + jitter, clamped to min/max).
TYPING_MIN_MS=1200
TYPING_MAX_MS=6000
TYPING_PER_CHAR_MS=45
# Minimum gap between two messages to the same recipient.
PER_RECIPIENT_MIN_MS=60000

# Daily cap (0 = unlimited) and optional warm-up ramp (start/day, growth/day).
DAILY_CAP=0
WARMUP_ENABLED=false
WARMUP_START=40
WARMUP_GROWTH=1.5

# Optional quiet hours (local to TZ); sends hold until the window opens.
TZ=UTC
WINDOW_START_HOUR=0
WINDOW_END_HOUR=24

# Retries + how long terminal jobs stay queryable/idempotent.
WA_MAX_ATTEMPTS=3
WA_JOB_TTL_MS=86400000
